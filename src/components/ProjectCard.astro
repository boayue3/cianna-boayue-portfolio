---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a class="card" href={`/work/${project.slug}`}>
  <div class="thumb placeholder-image">[ image ]<br />1200×900</div>
  <div class="meta-row">
    <span class="index accent">{project.index}</span>
    <span class="year">{project.year}</span>
  </div>
  <div class="title">{project.title}</div>
  <div class="desc">{project.description}</div>
  <div class="chips">
    <span class="chip chip--accent">{project.type}</span>
    {project.tags.map((tag) => <span class="chip">{tag}</span>)}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 13px;
    color: inherit;
  }

  .thumb {
    height: 240px;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font: 400 11px var(--font-body);
  }

  .year {
    color: var(--ink-40);
  }

  .title {
    font: 400 17px/1.3 var(--font-display);
  }

  .desc {
    font: 300 11.5px/1.75 var(--font-body);
    color: var(--ink-60);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .thumb {
      height: 170px;
    }
    .desc {
      display: none;
    }
  }
</style>
