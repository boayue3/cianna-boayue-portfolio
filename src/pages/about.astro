---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { about } from '../data/about';
---

<Layout title={`About — ${site.name}`}>
  <main class="page">
    <TopBar active="about" />

    <div class="content">
      <div class="eyebrow accent">{about.eyebrow}</div>

      <div class="about-layout">
        <div class="portrait">
          <img src="/about/cianna-grad.jpg" alt="Cianna Boayue" />
        </div>
        <div class="bio">
          {about.paragraphs.map((paragraph) => <p class="paragraph">{paragraph}</p>)}
        </div>
      </div>

      <Footer />
    </div>
  </main>
</Layout>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 56px var(--gutter-desktop);
    background: var(--paper);
    color: var(--ink);
  }

  .content {
    margin-top: 40px;
  }

  .content > .eyebrow {
    letter-spacing: 0.2em;
  }

  .about-layout {
    margin-top: 26px;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 56px;
    align-items: start;
  }

  .portrait {
    height: 440px;
    overflow: hidden;
    border: 1px solid var(--hairline);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio {
    max-width: 620px;
  }

  .paragraph {
    margin: 0 0 20px;
    font: 300 15px/1.95 var(--font-body);
    color: var(--ink-80);
  }

  .paragraph:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .page {
      padding: 34px var(--gutter-mobile) 40px;
    }
    .content {
      margin-top: 0;
    }
    .about-layout {
      margin-top: 22px;
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .portrait {
      height: 480px;
    }
    .paragraph {
      font-size: 13px;
    }
  }
</style>
