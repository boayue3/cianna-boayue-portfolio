---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import { site } from '../data/site';
import { about } from '../data/about';
---

<Layout title={`About — ${site.name}`}>
  <main class="page">
    <TopBar active="about" />

    <div class="content">
      <div class="eyebrow accent">{about.eyebrow}</div>
      <h1 class="heading">{about.heading}</h1>
      <p class="paragraph">{about.paragraph}</p>

      <div class="timeline">
        {about.timeline.map((row) => (
          <div class="row">
            <span class="accent">{row.year}</span>
            <span>{row.text}</span>
          </div>
        ))}
      </div>

      <div class="skills">
        <div>
          <div class="skills-label">Design</div>
          <div class="skills-list">{about.design.join(' · ')}</div>
        </div>
        <div>
          <div class="skills-label">Code</div>
          <div class="skills-list">{about.code.join(' · ')}</div>
        </div>
      </div>

      <div class="portrait placeholder-image">[ photo placeholder — 1200×640 ]</div>
    </div>
  </main>
</Layout>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px var(--gutter-narrow);
    background: var(--paper);
    color: var(--ink);
  }

  .content {
    margin-top: 40px;
  }

  .content > .eyebrow {
    letter-spacing: 0.2em;
  }

  .heading {
    margin: 18px 0 0;
    font: 700 30px/1.35 var(--font-display);
    letter-spacing: -0.02em;
  }

  .paragraph {
    margin: 24px 0 0;
    font: 300 14px/1.95 var(--font-body);
    color: var(--ink-80);
  }

  .timeline {
    margin-top: 40px;
  }

  .row {
    display: grid;
    grid-template-columns: 74px 1fr;
    gap: 20px;
    padding: 15px 0;
    border-top: 1px solid var(--hairline);
    font: 400 12.5px/1.6 var(--font-body);
  }

  .timeline .row:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .skills {
    margin-top: 34px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }

  .skills-label {
    font: 400 10px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-40);
  }

  .skills-list {
    margin-top: 9px;
    font: 300 12px/1.9 var(--font-body);
    color: var(--ink-80);
  }

  .portrait {
    margin-top: 38px;
    height: 210px;
    font-size: 11px;
  }

  @media (max-width: 640px) {
    .page {
      padding: 34px var(--gutter-mobile) 40px;
    }
    .content {
      margin-top: 0;
    }
    .heading {
      font-size: 24px;
      line-height: 1.3;
    }
    .paragraph {
      font-size: 13px;
    }
    .skills {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
</style>
