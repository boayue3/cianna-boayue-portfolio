---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { projects, getNextProject, type Project } from '../../data/projects';
import { site } from '../../data/site';

const caseStudies = projects.filter((p) => p.caseStudy);

export function getStaticPaths() {
  return projects
    .filter((project) => project.caseStudy)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props as { project: Project & { caseStudy: NonNullable<Project['caseStudy']> } };
const next = getNextProject(project.slug);
const position = `${project.index} / ${String(caseStudies.length).padStart(2, '0')}`;
const factLabels = {
  role: project.caseStudy.factLabels?.role ?? 'Role',
  team: project.caseStudy.factLabels?.team ?? 'Team',
  span: project.caseStudy.factLabels?.span ?? 'Span',
  result: project.caseStudy.factLabels?.result ?? 'Result',
};
---

<Layout title={`${project.title} — ${site.name}`} description={project.description}>
  <main class="page">
    <div class="back-bar">
      <a href="/" class="back accent">← {site.name}</a>
      <span class="reading">{position} · {project.caseStudy.readTime}</span>
    </div>

    <div class="content">
      <div class="eyebrow accent">{project.caseStudy.number}</div>
      <h1 class="title">{project.title}</h1>
      <p class="standfirst">{project.caseStudy.standfirst}</p>

      <div class="fact-strip">
        <div class="fact"><div class="fact-label">{factLabels.role}</div><div class="fact-value">{project.caseStudy.fact.role}</div></div>
        <div class="fact"><div class="fact-label">{factLabels.team}</div><div class="fact-value">{project.caseStudy.fact.team}</div></div>
        <div class="fact"><div class="fact-label">{factLabels.span}</div><div class="fact-value">{project.caseStudy.fact.span}</div></div>
        <div class="fact"><div class="fact-label">{factLabels.result}</div><div class="fact-value">{project.caseStudy.fact.result}</div></div>
      </div>

      {project.coverImage ? (
        <div class="hero-image hero-image--photo">
          <img src={project.coverImage} alt={project.caseStudy.heroCaption} />
        </div>
      ) : (
        <div class="hero-image placeholder-image">[ hero image placeholder ]<br />{project.caseStudy.heroCaption}</div>
      )}

      <div class="steps">
        {project.caseStudy.steps.map((step) => (
          <div class="step">
            <div class="step-label accent">{step.label}</div>
            <div class="step-body">
              {step.kind === 'statement' && (
                <>
                  <div class="statement">{step.statement}</div>
                  <p class="paragraph">{step.paragraph}</p>
                </>
              )}
              {step.kind === 'quote' && (
                <>
                  <p class="paragraph" style="margin:0">{step.paragraph}</p>
                  <div class="quote">{step.quote}</div>
                </>
              )}
              {step.kind === 'text' && <p class="paragraph" style="margin:0">{step.paragraph}</p>}
              {step.kind === 'explorations' && (
                <>
                  <p class="paragraph explorations-intro">{step.paragraph}</p>
                  <div class="explorations">
                    {step.explorations?.map((ex) => (
                      <div class="exploration">
                        <div class:list={['exploration-thumb', { shipped: ex.shipped }]}>[ {ex.caption} ]</div>
                        <div class:list={['exploration-verdict', { shipped: ex.shipped }]}>{ex.verdict}</div>
                      </div>
                    ))}
                  </div>
                </>
              )}
              {step.kind === 'stats' && (
                <div class="stat-grid">
                  {step.stats?.map((stat) => (
                    <div class="stat-cell">
                      <div class="stat-figure">{stat.figure}</div>
                      <div class="stat-caption">{stat.caption}</div>
                    </div>
                  ))}
                </div>
              )}
              {step.kind === 'testimonials' && (
                <div class="testimonials">
                  {step.testimonials?.map((t) => (
                    <div class="testimonial">
                      <div class="testimonial-quote">“{t.quote}”</div>
                      <div class="testimonial-name">{t.name}</div>
                      <div class="testimonial-role">{t.role}</div>
                    </div>
                  ))}
                </div>
              )}
              {step.kind === 'insights' && (
                <div class="insight-groups">
                  {step.insightGroups?.map((group) => (
                    <div class="insight-group">
                      <div class="insight-title accent">{group.title}</div>
                      <ul class="insight-list">
                        {group.points.map((point) => <li>{point}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
              {step.kind === 'comparison' && (
                <>
                  <p class="paragraph" style="margin:0 0 18px">{step.paragraph}</p>
                  <div class="comparisons">
                    {step.comparisons?.map((c) => (
                      <div class:list={['comparison-card', { highlight: c.highlight }]}>
                        <div class:list={['comparison-name', { highlight: c.highlight }]}>{c.name}</div>
                        <p class="comparison-desc">{c.description}</p>
                      </div>
                    ))}
                  </div>
                </>
              )}
              {step.kind === 'gallery' && (
                <>
                  {step.paragraph && <p class="paragraph" style="margin:0 0 18px">{step.paragraph}</p>}
                  <div class="gallery">
                    {step.gallery?.map((g) => (
                      g.src ? (
                        <figure class="gallery-figure">
                          <img src={g.src} alt={g.caption} />
                          <figcaption>{g.caption}</figcaption>
                        </figure>
                      ) : (
                        <div class="gallery-thumb placeholder-image">[ image ]<br />{g.caption}</div>
                      )
                    ))}
                  </div>
                </>
              )}
              {step.kind === 'list' && (
                <ul class:list={['step-list', { numbered: step.ordered !== false }]}>
                  {step.listItems?.map((item) => (
                    <li>
                      {item.title && <strong>{item.title}</strong>}{item.title ? ' ' : ''}{item.body}
                      {item.subitems && (
                        <ul class="sublist">
                          {item.subitems.map((sub) => (
                            <li><strong>{sub.title}</strong> — {sub.body}</li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
              {step.kind === 'quotelist' && (
                <>
                  {step.paragraph && <p class="paragraph" style="margin:0 0 20px">{step.paragraph}</p>}
                  <div class="quote-list">
                    {step.quoteList?.map((q) => (
                      <div class="quote-list-item">
                        <p class="paragraph" style="margin:0 0 10px">{q.context}</p>
                        {q.quotes.map((quote) => <div class="quote">{quote}</div>)}
                      </div>
                    ))}
                  </div>
                </>
              )}
              {step.kind === 'evidence' && (
                <>
                  {step.paragraph && <p class="paragraph" style="margin:0 0 20px">{step.paragraph}</p>}
                  <div class="evidence-grid">
                    {step.evidenceRows?.map((row) => (
                      <div class="evidence-row">
                        {row.images?.length ? (
                          <div class="evidence-thumbs">
                            {row.images.map((src) => (
                              <div class="evidence-thumb evidence-thumb--photo">
                                <img src={src} alt={row.title} />
                              </div>
                            ))}
                          </div>
                        ) : (
                          <div class="evidence-thumb placeholder-image">[ image ]<br />{row.title}</div>
                        )}
                        <div class="evidence-body">
                          <div class="evidence-title">{row.title}</div>
                          <p class="evidence-desc">{row.body}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </>
              )}
              {step.kind === 'carousel' && step.carousel && (
                <>
                  {step.paragraph && <p class="paragraph" style="margin:0 0 20px">{step.paragraph}</p>}
                  <div class="hifi-carousel" data-carousel>
                    <div class="hifi-stage">
                      <button class="hifi-nav hifi-nav--prev" type="button" aria-label="Previous screen">‹</button>
                      <div class="hifi-slides">
                        {step.carousel.map((slide, i) => (
                          <div class="hifi-slide" data-slide={i} hidden={i !== 0}>
                            <img src={slide.src} alt={slide.caption} />
                            <div class="hifi-caption">{slide.caption}</div>
                            {slide.annotations?.map((note) => (
                              <div class="hifi-annotation">
                                {note.title && <div class="hifi-annotation-title accent">{note.title}</div>}
                                <p class="hifi-annotation-text">{note.body}</p>
                                {note.items && (
                                  <ul class="hifi-annotation-list">
                                    {note.items.map((item) => (
                                      <li><strong>{item.title}</strong> — {item.body}</li>
                                    ))}
                                  </ul>
                                )}
                              </div>
                            ))}
                          </div>
                        ))}
                      </div>
                      <button class="hifi-nav hifi-nav--next" type="button" aria-label="Next screen">›</button>
                    </div>
                    <div class="hifi-dots">
                      {step.carousel.map((_, i) => (
                        <button class:list={['hifi-dot', { active: i === 0 }]} type="button" data-dot={i} aria-label={`Go to screen ${i + 1}`} />
                      ))}
                    </div>
                  </div>
                </>
              )}
              {step.kind === 'screens' && step.screenFlows && (
                <>
                  {step.paragraph && <p class="paragraph" style="margin:0 0 22px">{step.paragraph}</p>}
                  <div class="screen-flows">
                    {step.screenFlows.map((flow) => (
                      <div class:list={['screen-flow', { compact: flow.shots.length <= 2 }]}>
                        <div class="screen-flow-label accent">{flow.label}</div>
                        <div class="screen-row">
                          {flow.shots.map((src) => (
                            <img src={src} alt={flow.label} loading="lazy" />
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </>
              )}
              {step.kind === 'image' && step.image && (
                <>
                  {step.paragraph && <p class="paragraph" style="margin:0 0 18px">{step.paragraph}</p>}
                  <figure class="step-figure">
                    <img src={step.image.src} alt={step.image.caption ?? ''} />
                    {step.image.caption && <figcaption>{step.image.caption}</figcaption>}
                  </figure>
                </>
              )}
              {step.kind === 'video' && step.video && (
                <>
                  {step.paragraph && <p class="paragraph" style="margin:0 0 18px">{step.paragraph}</p>}
                  <figure class="step-figure">
                    {step.video.loop ? (
                      <video src={step.video.src} poster={step.video.poster} autoplay loop muted playsinline preload="auto" disablepictureinpicture controlslist="nodownload noplaybackrate" data-loop-video />
                    ) : (
                      <video controls poster={step.video.poster} src={step.video.src} />
                    )}
                    {step.video.caption && <figcaption>{step.video.caption}</figcaption>}
                  </figure>
                </>
              )}
              {step.kind === 'reflection' && (
                <>
                  <p class="paragraph" style="margin:0 0 22px">{step.paragraph}</p>
                  <div class="reflection-grid">
                    <div class="reflection-col">
                      <div class="reflection-title accent">What worked</div>
                      <ul class="reflection-list">
                        {step.worked?.map((item) => <li>{item}</li>)}
                      </ul>
                    </div>
                    <div class="reflection-col">
                      <div class="reflection-title accent">Open questions</div>
                      <ul class="reflection-list">
                        {step.openQuestions?.map((item) => <li>{item}</li>)}
                      </ul>
                    </div>
                  </div>
                </>
              )}
            </div>
          </div>
        ))}
      </div>

      <a href={`/work/${next.slug}`} class="next-bar">
        <span class="next-label">Next</span>
        <span class="next-title">{next.title} <span class="accent">→</span></span>
      </a>

      <Footer />
    </div>
  </main>
</Layout>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    background: var(--paper);
    color: var(--ink);
  }

  .back-bar {
    padding: 20px 88px;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    font: 400 12px var(--font-body);
    color: var(--ink-40);
  }

  .content {
    padding: 60px 88px 68px;
  }

  .eyebrow {
    font: 400 11px/1 var(--font-body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .title {
    margin: 16px 0 0;
    font: 700 42px/1.2 var(--font-display);
    letter-spacing: -0.025em;
    max-width: 620px;
  }

  .standfirst {
    margin: 20px 0 0;
    max-width: 580px;
    font: 300 15px/1.9 var(--font-body);
    color: var(--ink-80);
  }

  .fact-strip {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 20px 0;
  }

  .fact-label {
    font: 400 10px/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-40);
  }

  .fact-value {
    margin-top: 7px;
    font: 400 12.5px/1.5 var(--font-body);
  }

  .hero-image {
    margin-top: 44px;
    height: 420px;
    font-size: 11px;
    line-height: 1.7;
  }

  .hero-image--photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .steps {
    margin-top: 56px;
  }

  .step {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 36px;
    padding: 34px 0;
    border-top: 1px solid var(--hairline);
  }

  .steps .step:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .step-label {
    font: 400 11px/1.6 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .step-body {
    max-width: 520px;
  }

  .statement {
    font: 400 17px/1.55 var(--font-display);
  }

  .paragraph {
    margin: 14px 0 0;
    font: 300 13.5px/1.95 var(--font-body);
    color: var(--ink-80);
  }

  .quote {
    margin-top: 18px;
    padding: 16px 18px;
    border-left: 2px solid var(--accent);
    background: var(--paper-alt);
    font: 400 12.5px/1.8 var(--font-body);
  }

  .explorations-intro {
    margin-bottom: 18px;
  }

  .step-body:has(.explorations),
  .step-body:has(.testimonials),
  .step-body:has(.insight-groups),
  .step-body:has(.comparisons),
  .step-body:has(.gallery),
  .step-body:has(.step-figure),
  .step-body:has(.step-list),
  .step-body:has(.quote-list),
  .step-body:has(.evidence-grid),
  .step-body:has(.reflection-grid) {
    max-width: 760px;
  }

  .step-body:has(.screen-flows),
  .step-body:has(.hifi-carousel) {
    max-width: none;
  }

  .step:has(.hifi-carousel) {
    display: block;
  }

  .step:has(.hifi-carousel) .step-label {
    margin-bottom: 6px;
  }

  .step:has(.hifi-carousel) .step-body {
    margin-top: 16px;
  }

  .testimonials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .testimonial {
    padding: 18px 20px;
    border-left: 2px solid var(--accent);
    background: var(--paper-alt);
  }

  .testimonial-quote {
    font: 400 12.5px/1.8 var(--font-body);
  }

  .testimonial-name {
    margin-top: 14px;
    font: 700 12px var(--font-display);
  }

  .testimonial-role {
    margin-top: 2px;
    font: 300 10.5px var(--font-body);
    color: var(--ink-40);
  }

  .insight-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .insight-title {
    font: 400 11px/1 var(--font-body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .insight-list {
    margin: 14px 0 0;
    padding-left: 18px;
    font: 300 13px/1.8 var(--font-body);
    color: var(--ink-80);
  }

  .insight-list li {
    margin-bottom: 10px;
  }

  .comparisons {
    display: flex;
    gap: 14px;
  }

  .comparison-card {
    flex: 1;
    padding: 18px;
    border: 1px solid var(--hairline);
  }

  .comparison-card.highlight {
    border: 1px solid var(--accent);
    background: var(--paper-alt);
  }

  .comparison-name {
    font: 700 13px var(--font-display);
  }

  .comparison-name.highlight {
    color: var(--accent);
  }

  .comparison-desc {
    margin: 10px 0 0;
    font: 300 11.5px/1.75 var(--font-body);
    color: var(--ink-60);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
  }

  .gallery-thumb {
    height: 190px;
    font-size: 10.5px;
    line-height: 1.7;
  }

  .gallery-figure {
    margin: 0;
  }

  .gallery-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
  }

  .gallery-figure figcaption {
    margin-top: 10px;
    font: 300 11px/1.6 var(--font-body);
    color: var(--ink-40);
  }

  .screen-flows {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .screen-flow {
    flex: 1 1 100%;
    box-sizing: border-box;
    background: var(--paper-raised);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 24px 22px 26px;
  }

  .screen-flow.compact {
    flex: 1 1 calc(50% - 10px);
    padding: 24px 18px 26px;
  }

  .screen-flow-label {
    margin: 0 0 16px;
    font: 400 12px/1 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .screen-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .screen-row img {
    display: block;
    height: 360px;
    width: auto;
    filter: drop-shadow(0 10px 22px rgba(28, 26, 23, 0.14));
  }

  .screen-flow.compact .screen-row img {
    height: 328px;
  }

  .step-figure {
    margin: 0;
  }

  .step-figure img,
  .step-figure video {
    display: block;
    width: 100%;
    border: 1px solid var(--hairline);
  }

  .step-figure figcaption {
    margin-top: 10px;
    font: 300 11px/1.6 var(--font-body);
    color: var(--ink-40);
  }

  .step-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
    font: 300 13px/1.85 var(--font-body);
    color: var(--ink-80);
  }

  .step-list > li {
    position: relative;
  }

  .step-list > li + li {
    margin-top: 16px;
  }

  .step-list.numbered {
    counter-reset: step-list-counter;
  }

  .step-list.numbered > li {
    counter-increment: step-list-counter;
    padding-left: 28px;
  }

  .step-list.numbered > li::before {
    content: counter(step-list-counter) '.';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .step-list:not(.numbered) > li {
    padding-left: 18px;
  }

  .step-list:not(.numbered) > li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ink-40);
  }

  .step-list .sublist {
    margin: 14px 0 0;
    padding-left: 18px;
    list-style: none;
  }

  .step-list .sublist > li {
    padding-left: 0;
  }

  .step-list .sublist > li::before {
    content: none;
  }

  .step-list .sublist > li + li {
    margin-top: 10px;
  }

  .quote-list-item + .quote-list-item {
    margin-top: 26px;
  }

  .quote-list-item .quote + .quote {
    margin-top: 10px;
  }

  .evidence-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .evidence-row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--hairline);
  }

  .evidence-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .evidence-thumbs {
    display: flex;
    gap: 10px;
    flex: 0 0 auto;
  }

  .evidence-thumb {
    width: 200px;
    height: 130px;
    font-size: 10px;
    line-height: 1.6;
  }

  .evidence-thumb--photo {
    width: 200px;
    height: 260px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--paper-sunken);
  }

  .evidence-thumb--photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .evidence-body {
    flex: 1 1 240px;
    min-width: 240px;
  }

  .evidence-title {
    font: 700 13px var(--font-display);
  }

  .evidence-desc {
    margin: 8px 0 0;
    font: 300 12px/1.75 var(--font-body);
    color: var(--ink-60);
  }

  .hifi-carousel {
    max-width: 1004px;
  }

  .hifi-stage {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hifi-nav {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    border: 1px solid var(--hairline-strong);
    background: var(--paper);
    color: var(--ink);
    font: 400 16px var(--font-body);
    cursor: pointer;
  }

  .hifi-nav:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hifi-slides {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hifi-slide {
    text-align: center;
  }

  .hifi-slide img {
    display: block;
    height: 588px;
    width: auto;
    max-width: 100%;
    margin: 0 auto;
  }

  .hifi-caption {
    margin: 14px auto 0;
    max-width: 640px;
    text-align: center;
    font: 400 12px/1.5 var(--font-body);
    color: var(--ink-60);
  }

  .hifi-annotation {
    margin: 16px auto 0;
    max-width: 640px;
    padding: 14px 16px;
    border-left: 2px solid var(--accent);
    background: var(--paper-alt);
    text-align: left;
  }

  .hifi-annotation-title {
    font: 700 12px/1.4 var(--font-display);
  }

  .hifi-annotation-text {
    margin: 8px 0 0;
    font: 300 12.5px/1.75 var(--font-body);
    color: var(--ink-80);
  }

  .hifi-annotation-list {
    margin: 10px 0 0;
    padding-left: 18px;
    font: 300 12px/1.7 var(--font-body);
    color: var(--ink-80);
  }

  .hifi-annotation-list li {
    margin-bottom: 8px;
  }

