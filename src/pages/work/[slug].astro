<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('.hifi-nav--prev');
    const next = root.querySelector<HTMLButtonElement>('.hifi-nav--next');
    let active = 0;

    function show(i: number) {
      active = (i + slides.length) % slides.length;
      slides.forEach((slide, idx) => {
        slide.hidden = idx !== active;
      });
      dots.forEach((dot, idx) => dot.classList.toggle('active', idx === active));
    }

    prev?.addEventListener('click', () => show(active - 1));
    next?.addEventListener('click', () => show(active + 1));
    dots.forEach((dot, idx) => dot.addEventListener('click', () => show(idx)));
  });

  // Keep the no-controls loop video playing even when a browser defers muted autoplay.
  document.querySelectorAll<HTMLVideoElement>('video[data-loop-video]').forEach((video) => {
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.loop = true;
    const tryPlay = () => {
      if (!video.paused) return;
      const p = video.play();
      if (p) p.catch(() => {});
    };
    ['loadeddata', 'canplay', 'stalled', 'suspend'].forEach((evt) =>
      video.addEventListener(evt, tryPlay)
    );
    [0, 200, 600, 1500, 3000].forEach((ms) => setTimeout(tryPlay, ms));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((e) => e.isIntersecting && tryPlay());
      }, { threshold: 0.05 }).observe(video);
    }
    ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach((evt) =>
      window.addEventListener(evt, tryPlay, { passive: true })
    );
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) tryPlay();
    });
    video.load();
  });
</script>
