---
import Layout from '../../layouts/Layout.astro';
import { projects, getNextProject } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const next = getNextProject(project.slug);
const position = `${project.index} / ${String(projects.length).padStart(2, '0')}`;
---

<Layout title={`${project.title} — ${site.name}`} description={project.description}>
  <main class="page">
    <div class="back-bar">
      <a href="/" class="back accent">← {site.name}</a>
      <span class="reading">{position} · {project.caseStudy.readTime}</span>
    </div>

    <div class="content">
      <div class="eyebrow accent">{project.caseStudy.number}</div>
      <h1 class="title">{project.title}</h1>
      <p class="standfirst">{project.caseStudy.standfirst}</p>

      <div class="fact-strip">
        <div class="fact"><div class="fact-label">Role</div><div class="fact-value">{project.caseStudy.fact.role}</div></div>
        <div class="fact"><div class="fact-label">Team</div><div class="fact-value">{project.caseStudy.fact.team}</div></div>
        <div class="fact"><div class="fact-label">Span</div><div class="fact-value">{project.caseStudy.fact.span}</div></div>
        <div class="fact"><div class="fact-label">Result</div><div class="fact-value">{project.caseStudy.fact.result}</div></div>
      </div>

      <div class="hero-image placeholder-image">[ hero image placeholder ]<br />{project.caseStudy.heroCaption}</div>

      <div class="steps">
        {project.caseStudy.steps.map((step) => (
          <div class="step">
            <div class="step-label accent">{step.label}</div>
            <div class="step-body">
              {step.kind === 'statement' && (
                <>
                  <div class="statement">{step.statement}</div>
                  <p class="paragraph">{step.paragraph}</p>
                </>
              )}
              {step.kind === 'quote' && (
                <>
                  <p class="paragraph" style="margin:0">{step.paragraph}</p>
                  <div class="quote">{step.quote}</div>
                </>
              )}
              {step.kind === 'text' && <p class="paragraph" style="margin:0">{step.paragraph}</p>}
              {step.kind === 'explorations' && (
                <>
                  <p class="paragraph explorations-intro">{step.paragraph}</p>
                  <div class="explorations">
                    {step.explorations?.map((ex) => (
                      <div class="exploration">
                        <div class:list={['exploration-thumb', { shipped: ex.shipped }]}>[ {ex.caption} ]</div>
                        <div class:list={['exploration-verdict', { shipped: ex.shipped }]}>{ex.verdict}</div>
                      </div>
                    ))}
                  </div>
                </>
              )}
              {step.kind === 'stats' && (
                <div class="stat-grid">
                  {step.stats?.map((stat) => (
                    <div class="stat-cell">
                      <div class="stat-figure">{stat.figure}</div>
                      <div class="stat-caption">{stat.caption}</div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <a href={`/work/${next.slug}`} class="next-bar">
        <span class="next-label">Next</span>
        <span class="next-title">{next.title} <span class="accent">→</span></span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    background: var(--paper);
    color: var(--ink);
  }

  .back-bar {
    padding: 20px 88px;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    font: 400 12px var(--font-body);
    color: var(--ink-40);
  }

  .content {
    padding: 60px 88px 68px;
  }

  .eyebrow {
    font: 400 11px/1 var(--font-body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .title {
    margin: 16px 0 0;
    font: 700 42px/1.2 var(--font-display);
    letter-spacing: -0.025em;
    max-width: 620px;
  }

  .standfirst {
    margin: 20px 0 0;
    max-width: 580px;
    font: 300 15px/1.9 var(--font-body);
    color: var(--ink-80);
  }

  .fact-strip {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 20px 0;
  }

  .fact-label {
    font: 400 10px/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-40);
  }

  .fact-value {
    margin-top: 7px;
    font: 400 12.5px/1.5 var(--font-body);
  }

  .hero-image {
    margin-top: 44px;
    height: 420px;
    font-size: 11px;
    line-height: 1.7;
  }

  .steps {
    margin-top: 56px;
  }

  .step {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 36px;
    padding: 34px 0;
    border-top: 1px solid var(--hairline);
  }

  .steps .step:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .step-label {
    font: 400 11px/1.6 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .step-body {
    max-width: 520px;
  }

  .statement {
    font: 400 17px/1.55 var(--font-display);
  }

  .paragraph {
    margin: 14px 0 0;
    font: 300 13.5px/1.95 var(--font-body);
    color: var(--ink-80);
  }

  .quote {
    margin-top: 18px;
    padding: 16px 18px;
    border-left: 2px solid var(--accent);
    background: var(--paper-alt);
    font: 400 12.5px/1.8 var(--font-body);
  }

  .explorations-intro {
    margin-bottom: 18px;
  }

  .step-body:has(.explorations) {
    max-width: 760px;
  }

  .explorations {
    display: flex;
    gap: 12px;
  }

  .exploration {
    flex: 1;
  }

  .exploration-thumb {
    height: 190px;
    border: 1px dashed var(--hairline-dashed-strong);
    background: var(--paper-sunken);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 400 10.5px var(--font-body);
    color: var(--ink-40);
  }

  .exploration-thumb.shipped {
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .exploration-verdict {
    margin-top: 8px;
    font: 300 10.5px/1.5 var(--font-body);
    color: var(--ink-40);
  }

  .exploration-verdict.shipped {
    color: var(--accent);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(28, 26, 23, 0.18);
    border: 1px solid rgba(28, 26, 23, 0.18);
    max-width: 520px;
  }

  .stat-cell {
    background: var(--paper-raised);
    padding: 20px;
  }

  .stat-figure {
    font: 700 26px/1 var(--font-display);
  }

  .stat-caption {
    margin-top: 7px;
    font: 300 10.5px/1.5 var(--font-body);
    color: var(--ink-60);
  }

  .next-bar {
    margin-top: 50px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: var(--rule-heavy);
    padding-top: 20px;
  }

  .next-label {
    font: 400 11px var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-60);
  }

  .next-title {
    font: 700 21px/1 var(--font-display);
  }

  @media (max-width: 640px) {
    .back-bar {
      padding: 16px var(--gutter-mobile);
      font-size: 11px;
    }
    .content {
      padding: 26px var(--gutter-mobile) 40px;
    }
    .title {
      font-size: 26px;
      line-height: 1.24;
      margin-top: 12px;
    }
    .standfirst {
      font-size: 12.5px;
      line-height: 1.85;
      margin-top: 14px;
    }
    .fact-strip {
      margin-top: 22px;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      padding: 16px 0;
    }
    .fact-label {
      font-size: 9.5px;
    }
    .fact-value {
      font-size: 11.5px;
      margin-top: 6px;
    }
    .hero-image {
      margin-top: 22px;
      height: 200px;
    }
    .steps {
      margin-top: 34px;
    }
    .step {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 26px 0;
    }
    .step-body {
      max-width: none;
    }
    .statement {
      font-size: 15px;
    }
    .paragraph {
      font-size: 12.5px;
      line-height: 1.9;
    }
    .quote {
      font-size: 11.5px;
      padding: 14px 16px;
    }
    .explorations {
      flex-direction: column;
      gap: 18px;
    }
    .stat-grid {
      max-width: none;
    }
    .next-title {
      font-size: 17px;
    }
  }
</style>
